@model web_ban_thuoc.Models.News

@{
    ViewData["Title"] = Model.Title;
    var related = ViewBag.RelatedNews as IEnumerable<web_ban_thuoc.Models.News> ?? Enumerable.Empty<web_ban_thuoc.Models.News>();
}

<!-- Article -->
<div class="container py-4" style="max-width: 800px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/News">Góc sức khỏe</a></li>
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <li class="breadcrumb-item"><a href="/News/Category?category=@Model.Category">@Model.Category</a></li>
            }
            <li class="breadcrumb-item active">@(Model.Title.Length > 40 ? Model.Title.Substring(0, 40) + "..." : Model.Title)</li>
        </ol>
    </nav>

    <article style="background: white; padding: 1.5rem; border-radius: 1rem; box-shadow: 0 1px 6px rgba(0,0,0,0.06);">
        <!-- Cover image -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@(Model.ImageUrl ?? "/images/placeholder.png")" class="rounded-4 w-100 mb-4"
                 alt="@Model.Title" style="max-height: 420px; object-fit: cover;"
                 onerror="this.style.display='none'" />
        }

        <!-- Meta -->
        <div class="d-flex flex-wrap gap-3 mb-3 text-muted small">
            @if (!string.IsNullOrEmpty(Model.Author))
            {
                <span><i class="fa fa-user me-1"></i>@Model.Author</span>
            }
            @if (Model.PublishedAt.HasValue)
            {
                <span><i class="fa fa-calendar me-1"></i>@Model.PublishedAt.Value.ToString("dd/MM/yyyy")</span>
            }
            <span><i class="fa fa-eye me-1"></i>@Model.ViewCount lượt xem</span>
            @if (!string.IsNullOrEmpty(Model.Source))
            {
                <span>Nguồn: @Model.Source</span>
            }
        </div>

        <!-- Title + Category -->
        @if (!string.IsNullOrEmpty(Model.Category))
        {
            <a href="/News/Category?category=@Model.Category" class="badge bg-primary-subtle text-primary text-decoration-none mb-2">
                @Model.Category
            </a>
        }
        <h1 class="fw-bold mb-3">@Model.Title</h1>

        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p class="lead text-muted mb-4" style="font-size: 1.1rem;">@Model.Summary</p>
        }

        <hr class="my-4" />

        <!-- WYSIWYG Content -->
        <div class="news-content">
            @Html.Raw(Model.Content)
        </div>
    </article>

    <!-- Share -->
    <div class="d-flex align-items-center gap-3 mt-5 py-4 border-top">
        <span class="text-muted small">Chia sẻ:</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u=@Context.Request.Path"
           target="_blank" class="btn btn-outline-primary btn-sm rounded-pill">
            <i class="fa fa-facebook me-1"></i>Facebook
        </a>
    </div>
</div>

<!-- Related -->
@if (related.Any())
{
    <div class="container py-4">
        <h4 class="fw-bold mb-3">Bài viết liên quan</h4>
        <div class="row g-3">
            @foreach (var item in related)
            {
                <div class="col-md-4">
                    <a href="/News/Details/@item.NewsId" class="text-decoration-none text-dark">
                        <div class="card border-0 shadow-sm rounded-3 h-100 news-related-card">
                            <img src="@(item.ImageUrl ?? "/images/placeholder.png")"
                                 class="card-img-top" alt="@item.Title"
                                 style="height: 140px; object-fit: cover;"
                                 onerror="this.src='/images/placeholder.png'" />
                            <div class="card-body">
                                <h6 class="card-title fw-semibold line-clamp-2">@item.Title</h6>
                                <small class="text-muted">@((item.PublishedAt ?? item.CreatedAt).ToString("dd/MM/yyyy"))</small>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}

<style>
    .news-content h1, .news-content h2, .news-content h3,
    .news-content h4, .news-content h5, .news-content h6 {
        font-weight: 700;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: #1a1a1a;
    }
    .news-content p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #374151;
        margin-bottom: 1rem;
    }
    .news-content img {
        max-width: 100%;
        height: auto;
        border-radius: 0.75rem;
        margin: 1rem 0;
    }
    .news-content ul, .news-content ol {
        padding-left: 1.5rem;
        margin-bottom: 1rem;
    }
    .news-content li {
        line-height: 1.8;
        margin-bottom: 0.25rem;
    }
    .news-content blockquote {
        border-left: 4px solid #3b82f6;
        padding: 0.75rem 1rem;
        background: #eff6ff;
        border-radius: 0 0.5rem 0.5rem 0;
        margin: 1.5rem 0;
        color: #475569;
        font-style: italic;
    }
    .news-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
    }
    .news-content table th {
        background: #f9fafb;
        padding: 0.5rem 0.75rem;
        border: 1px solid #e5e7eb;
        text-align: left;
    }
    .news-content table td {
        padding: 0.5rem 0.75rem;
        border: 1px solid #e5e7eb;
    }
    .news-related-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .news-related-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.08) !important;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
