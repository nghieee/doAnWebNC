@model List<web_ban_thuoc.Models.Product>
@foreach (var product in Model)
{
    var mainImage = product.ProductImages?.FirstOrDefault(i => i.IsMain == true) ?? product.ProductImages?.FirstOrDefault();
    <div class="col">
        <div class="product-card shadow-sm position-relative">
            @if (product.IsOnDiscount)
            {
                <div class="position-absolute top-0 start-0 m-2 z-1">
                    <span class="badge bg-danger shadow-sm px-2 py-1 fs-7 fw-bold rounded-pill">
                        -@product.DiscountPercentCalculated%
                    </span>
                </div>
            }
            <a class="text-decoration-none d-flex flex-column h-100" href="@Url.Action("Details", "Product", new { id = product.ProductId })">
                <div class="product-image-wrapper">
                    <img src="/images/products/@(mainImage?.ImageUrl ?? "/images/sanpham.png")"
                        alt="@product.ProductName" />
                </div>
                <div class="px-3 pb-2 flex-grow-1 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="product-title" title="@product.ProductName">@product.ProductName</h5>
                    </div>
                    <div>
                        @if (product.IsOnDiscount)
                        {
                            <div class="product-price text-danger fw-bold">@product.EffectivePrice.ToString("N0")đ</div>
                            <div class="product-original-price text-decoration-line-through text-muted small">@product.Price.ToString("N0")đ</div>
                        }
                        else
                        {
                            <div class="product-price">@product.Price.ToString("N0")đ</div>
                            <div class="product-original-price text-muted small" style="visibility: hidden;">0đ</div>
                        }
                        <span class="product-unit">@(product.Package ?? "Hộp")</span>
                    </div>
                </div>
            </a>
            <div class="px-3 pb-3 pt-2">
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="add-to-cart-form">
                    <input type="hidden" name="productId" value="@product.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-primary w-100 rounded-pill btn-sm fw-medium">Thêm vào giỏ</button>
                </form>
            </div>
        </div>
    </div>
} 