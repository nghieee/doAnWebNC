@model List<web_ban_thuoc.Models.Product>

<div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3" id="product-list">
    @if (Model != null && Model.Any())
    {
        foreach (var product in Model)
        {
            var mainImage = product.ProductImages?.FirstOrDefault(i => i.IsMain == true) ??
            product.ProductImages?.FirstOrDefault();
            <div class="col">
                <div class="product-card shadow-sm">
                    <a class="text-decoration-none d-flex flex-column h-100" href="@Url.Action("Details", "Product", new { id = product.ProductId })">
                        <div class="product-image-wrapper">
                            <img src="/images/products/@(mainImage?.ImageUrl ?? "/images/sanpham.png")"
                                alt="@product.ProductName" />
                        </div>
                        <div class="px-3 pb-2 flex-grow-1 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="product-title" title="@product.ProductName">@product.ProductName</h5>
                            </div>
                            <div>
                                <div class="product-price">@product.Price.ToString("N0")đ</div>
                                <div class="product-original-price">@((product.Price * 1.25m).ToString("N0"))đ</div>
                                <span class="product-unit">@(product.Package ?? "Hộp")</span>
                            </div>
                        </div>
                    </a>
                    <div class="px-3 pb-3 pt-2">
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="add-to-cart-form">
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-primary w-100 rounded-pill btn-sm fw-medium py-1-5">Thêm vào giỏ</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted">
            <div class="py-5 bg-white rounded-3 shadow-sm">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Không tìm thấy sản phẩm nào</h5>
                <p class="text-muted mb-0">Hãy thử thay đổi bộ lọc hoặc tìm kiếm với từ khóa khác.</p>
            </div>
        </div>
    }
</div> 