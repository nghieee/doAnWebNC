<!-- Modal Thiết lập giảm giá sản phẩm -->
<div class="modal fade" id="setDiscountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark"><i class="fa fa-tag text-primary me-2"></i>Giảm giá sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/AdminDiscount/SetDiscount">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn sản phẩm giảm giá <span class="text-danger">*</span></label>
                        
                        <!-- Search Box inside Modal -->
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                            <input type="text" id="modalSearchProduct" class="form-control" placeholder="Tìm kiếm nhanh sản phẩm theo tên hoặc SKU..." />
                        </div>

                        <!-- Product selection table -->
                        <div class="table-responsive border rounded-3" style="max-height: 260px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0" id="modalProductTable">
                                <thead class="bg-light sticky-top">
                                    <tr class="small text-secondary fw-bold">
                                        <th class="text-center" style="width: 45px;">
                                            <input type="checkbox" id="modalSelectAllProducts" class="form-check-input" />
                                        </th>
                                        <th style="width: 50px;">Ảnh</th>
                                        <th>Tên sản phẩm</th>
                                        <th class="text-end pe-3">Giá gốc</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model)
                                    {
                                        var imgUrl = p.ProductImages?.FirstOrDefault(i => i.IsMain == true)?.ImageUrl 
                                                     ?? p.ProductImages?.FirstOrDefault()?.ImageUrl 
                                                     ?? "sanpham.png";
                                        <tr class="modal-product-row" data-name="@p.ProductName.ToLower()" data-sku="@(p.Sku?.ToLower() ?? "")">
                                            <td class="text-center">
                                                <input type="checkbox" name="productIds" value="@p.ProductId" class="form-check-input modal-product-checkbox" />
                                            </td>
                                            <td>
                                                <img src="/images/products/@imgUrl" alt="@p.ProductName" class="object-fit-contain rounded border" style="width: 36px; height: 36px; background-color: #f8fafc;" />
                                            </td>
                                            <td>
                                                <div class="small fw-bold text-dark text-truncate" style="max-width: 480px;">@p.ProductName</div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">SKU: @(p.Sku ?? "N/A")</div>
                                            </td>
                                            <td class="text-end pe-3 small fw-bold text-secondary">
                                                @p.Price.ToString("N0")đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="small text-muted mt-1"><i class="fa fa-info-circle me-1"></i>Đã chọn <strong id="modalCheckedCount" class="text-primary">0</strong> sản phẩm</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Phần trăm giảm (%)</label>
                            <div class="input-group">
                                <input type="number" step="0.1" min="1" max="99" name="discountPercent" id="modalDiscountPercent" class="form-control" placeholder="Ví dụ: 10" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Hoặc Giá bán sau giảm (VNĐ)</label>
                            <div class="input-group">
                                <input type="number" step="1000" min="0" name="discountPrice" id="modalDiscountPrice" class="form-control" placeholder="Ví dụ: 120000" />
                                <span class="input-group-text">đ</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Ngày bắt đầu</label>
                            <input type="datetime-local" name="startDate" id="modalStartDate" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Ngày kết thúc</label>
                            <input type="datetime-local" name="endDate" id="modalEndDate" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Gắn Banner quảng bá</label>
                        <select name="bannerId" id="modalBannerId" class="form-select">
                            <option value="">-- Không gắn banner --</option>
                            @foreach (var b in banners)
                            {
                                <option value="@b.BannerId">@b.Title (@(b.BannerType == "FullWidth" ? "Full Width" : b.BannerType))</option>
                            }
                        </select>
                        <div class="form-text">Khi click vào banner này trên trang chủ sẽ dẫn trực tiếp đến trang chi tiết sản phẩm.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="isActive" id="modalIsActive" value="true" checked />
                        <label class="form-check-label fw-semibold" for="modalIsActive">Kích hoạt giảm giá ngay</label>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="fa fa-save me-1"></i>Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('modalSearchProduct');
            const rows = document.querySelectorAll('.modal-product-row');
            const selectAllCheckbox = document.getElementById('modalSelectAllProducts');
            const productCheckboxes = document.querySelectorAll('.modal-product-checkbox');
            const checkedCountText = document.getElementById('modalCheckedCount');

            // 1. Live Search Filter in Modal Table
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const term = this.value.toLowerCase().trim();
                    rows.forEach(row => {
                        const name = row.getAttribute('data-name');
                        const sku = row.getAttribute('data-sku');
                        if (name.includes(term) || sku.includes(term)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }

            // Update Checked Count
            function updateCheckedCount() {
                if (checkedCountText) {
                    const checkedCount = document.querySelectorAll('.modal-product-checkbox:checked').length;
                    checkedCountText.textContent = checkedCount;
                }
            }

            // 2. Select All Checkbox Logic
            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    const isChecked = this.checked;
                    rows.forEach(row => {
                        if (row.style.display !== 'none') {
                            const checkbox = row.querySelector('.modal-product-checkbox');
                            if (checkbox) {
                                checkbox.checked = isChecked;
                            }
                        }
                    });
                    updateCheckedCount();
                });
            }

            // Individual Checkbox Click
            productCheckboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    updateCheckedCount();
                });
            });

            // 3. Edit Discount Button Click
            document.querySelectorAll('.edit-discount-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const productId = this.getAttribute('data-id');
                    const percent = this.getAttribute('data-percent');
                    const disprice = this.getAttribute('data-disprice');
                    const start = this.getAttribute('data-start');
                    const end = this.getAttribute('data-end');
                    const active = this.getAttribute('data-active') === 'true';
                    const bannerId = this.getAttribute('data-banner') || '0';

                    // Reset search
                    if (searchInput) searchInput.value = '';
                    rows.forEach(row => row.style.display = '');

                    // Uncheck all, check only the editing product
                    productCheckboxes.forEach(cb => {
                        cb.checked = (cb.value === productId);
                    });
                    if (selectAllCheckbox) selectAllCheckbox.checked = false;
                    updateCheckedCount();

                    // Fill other fields
                    document.getElementById('modalDiscountPercent').value = percent > 0 ? percent : '';
                    document.getElementById('modalDiscountPrice').value = disprice > 0 ? disprice : '';
                    document.getElementById('modalStartDate').value = start;
                    document.getElementById('modalEndDate').value = end;
                    document.getElementById('modalIsActive').checked = active;
                    document.getElementById('modalBannerId').value = bannerId !== '0' ? bannerId : '';

                    $('#setDiscountModal').modal('show');
                });
            });

            // Reset checkboxes when opening set discount modal via top button
            const setDiscountModalEl = document.getElementById('setDiscountModal');
            if (setDiscountModalEl) {
                setDiscountModalEl.addEventListener('show.bs.modal', function (event) {
                    // If triggered by the top button, not edit button
                    if (event.relatedTarget && event.relatedTarget.getAttribute('data-bs-target') === '#setDiscountModal') {
                        productCheckboxes.forEach(cb => cb.checked = false);
                        if (selectAllCheckbox) selectAllCheckbox.checked = false;
                        if (searchInput) searchInput.value = '';
                        rows.forEach(row => row.style.display = '');
                        document.getElementById('modalDiscountPercent').value = '';
                        document.getElementById('modalDiscountPrice').value = '';
                        document.getElementById('modalStartDate').value = '';
                        document.getElementById('modalEndDate').value = '';
                        document.getElementById('modalIsActive').checked = true;
                        document.getElementById('modalBannerId').value = '';
                        updateCheckedCount();
                    }
                });
            }

            // Ajax Toggle Switch for single product
            document.querySelectorAll('.discount-toggle-switch').forEach(sw => {
                sw.addEventListener('change', function () {
                    const productId = this.getAttribute('data-product-id');
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    fetch('/AdminDiscount/ToggleDiscount', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `productId=${productId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        }
                    })
                    .catch(err => console.error(err));
                });
            });

            // Ajax Toggle Switch for campaign
            document.querySelectorAll('.campaign-toggle-switch').forEach(sw => {
                sw.addEventListener('change', function () {
                    const campaignId = this.getAttribute('data-campaign-id');
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    fetch('/AdminDiscount/ToggleCampaign', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `campaignId=${campaignId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        }
                    })
                    .catch(err => console.error(err));
                });
            });

            // Edit Campaign Button click handler to populate and show modal using jQuery
            $('.edit-campaign-btn').on('click', function () {
                const btn = $(this);
                $('#edit-campaignId').val(btn.attr('data-campaign-id'));
                $('#edit-name').val(btn.attr('data-name'));
                $('#edit-description').val(btn.attr('data-desc') || '');
                $('#edit-discountPercent').val(btn.attr('data-discount'));
                
                const catId = btn.attr('data-category');
                $('#edit-categoryId').val((catId && catId !== "0") ? catId : "");
                
                $('#edit-brand').val(btn.attr('data-brand') || '');
                $('#edit-startDate').val(btn.attr('data-start'));
                $('#edit-endDate').val(btn.attr('data-end'));
                
                const bannerId = btn.attr('data-banner');
                $('#edit-bannerId').val((bannerId && bannerId !== "0") ? bannerId : "");
                
                $('#editCampaignModal').modal('show');
            });

            // 4. Log search filter by product name/sku
            const logSearchInput = document.getElementById('logSearchInput');
            if (logSearchInput) {
                const logProductRows = document.querySelectorAll('.log-product-row');
                logSearchInput.addEventListener('input', function () {
                    const term = this.value.toLowerCase().trim();
                    logProductRows.forEach(row => {
                        const name = row.getAttribute('data-name') || '';
                        const sku = row.getAttribute('data-sku') || '';
                        const targetId = row.getAttribute('data-target-id');
                        const subRow = document.getElementById(targetId);
                        
                        if (name.includes(term) || sku.includes(term)) {
                            row.style.display = '';
                            if (subRow) {
                                subRow.classList.remove('d-none');
                            }
                        } else {
                            row.style.display = 'none';
                            if (subRow) {
                                subRow.classList.add('d-none');
                                subRow.classList.remove('show');
                            }
                        }
                    });
                });
            }

            // 5. Tab state retention via localStorage
            const activeTabKey = 'discount_active_tab';
            const savedTabId = localStorage.getItem(activeTabKey);
            if (savedTabId) {
                const tabTrigger = document.querySelector(`#discountTabs button[data-bs-target="${savedTabId}"]`);
                if (tabTrigger) {
                    const tab = new bootstrap.Tab(tabTrigger);
                    tab.show();
                }
            }

            // Save active tab on click
            document.querySelectorAll('#discountTabs button[data-bs-toggle="tab"]').forEach(btn => {
                btn.addEventListener('shown.bs.tab', function (e) {
                    const targetId = this.getAttribute('data-bs-target');
                    localStorage.setItem(activeTabKey, targetId);
                });
            });
        });
    </script>
}
