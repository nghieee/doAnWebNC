@model web_ban_thuoc.Models.News
@{
    ViewData["Title"] = "Viết bài mới";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Viết bài mới</h4>
        <p class="text-muted small mb-0">Tạo nội dung tin tức mới cho website</p>
    </div>
    <a href="/AdminNews" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa fa-arrow-left me-2"></i>Quay lại
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 16px;">
    <div class="card-body p-4">
        <form method="post" action="/AdminNews/Create" enctype="multipart/form-data" id="newsForm">
            @Html.AntiForgeryToken()

            <div class="row g-4">
                <!-- Left: Content -->
                <div class="col-lg-8">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="fa fa-font me-1 text-primary"></i>Tiêu đề <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="Title" id="Title" class="form-control form-control-lg" required 
                               placeholder="Nhập tiêu đề hấp dẫn cho bài viết..." />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="fa fa-align-left me-1 text-primary"></i>Tóm tắt
                        </label>
                        <textarea name="Summary" id="Summary" class="form-control" rows="3" 
                                  placeholder="Mô tả ngắn gọn 1-2 câu (hiển thị trên danh sách tin)..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fa fa-file-text me-1 text-primary"></i>Nội dung <span class="text-danger">*</span>
                        </label>
                        <div id="quill-editor" style="height: 450px; border-radius: 12px;"></div>
                        <input type="hidden" name="Content" id="Content" />
                        <div class="form-text">Viết nội dung chi tiết cho bài viết tại đây.</div>
                    </div>
                </div>

                <!-- Right: Settings -->
                <div class="col-lg-4">
                    <!-- Cover Image -->
                    <div class="card mb-4 border" style="border-radius: 12px; overflow: hidden;">
                        <div class="card-header bg-white py-3" style="border-bottom: 1px solid #f1f1f1;">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-image text-primary me-2"></i>
                                <label class="form-label fw-semibold mb-0">Ảnh bìa</label>
                            </div>
                        </div>
                        <div class="card-body text-center p-4">
                            <div class="position-relative d-inline-block mb-3">
                                <img id="img-preview" src="/images/placeholder.png" class="rounded-3 shadow-sm"
                                     style="width: 100%; max-height: 200px; object-fit: cover;" />
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <label class="btn btn-outline-primary btn-sm rounded-pill cursor-pointer">
                                    <i class="fa fa-upload me-1"></i>Chọn ảnh
                                    <input type="file" name="CoverImage" id="CoverImage" class="d-none"
                                           accept="image/*" onchange="previewImage(this, 'img-preview')" />
                                </label>
                                <small class="text-muted">Định dạng: JPG, PNG, WebP (Tối đa 5MB)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Options -->
                    <div class="card mb-4 border" style="border-radius: 12px; overflow: hidden;">
                        <div class="card-header bg-white py-3" style="border-bottom: 1px solid #f1f1f1;">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-cog text-primary me-2"></i>
                                <label class="form-label fw-semibold mb-0">Tùy chọn xuất bản</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch mb-3 p-0">
                                <label class="d-flex align-items-center justify-content-between cursor-pointer">
                                    <span class="fw-medium">Hiển thị công khai</span>
                                    <input type="checkbox" name="IsPublished" class="form-check-input" 
                                           id="IsPublished" value="true" checked
                                           style="width: 48px; height: 26px;" />
                                </label>
                            </div>
                            <hr class="my-2" />
                            <div class="form-check form-switch mb-3 p-0">
                                <label class="d-flex align-items-center justify-content-between cursor-pointer">
                                    <span class="fw-medium">Bài viết nổi bật</span>
                                    <input type="checkbox" name="IsFeature" class="form-check-input" 
                                           id="IsFeature" value="true"
                                           style="width: 48px; height: 26px;" />
                                </label>
                            </div>

                            <hr class="my-3" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">
                                    <i class="fa fa-folder-open me-1"></i>Danh mục
                                </label>
                                <input type="text" name="Category" id="Category" class="form-control" 
                                       placeholder="VD: Dinh dưỡng..." list="category-list" />
                                <datalist id="category-list">
                                    <option value="Dinh dưỡng" />
                                    <option value="Bệnh thường gặp" />
                                    <option value="Sức khỏe tinh thần" />
                                    <option value="Mẹ và bé" />
                                    <option value="Người cao tuổi" />
                                    <option value="Thực phẩm chức năng" />
                                    <option value="Làm đẹp" />
                                    <option value="Tin tức" />
                                </datalist>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">
                                    <i class="fa fa-user me-1"></i>Tác giả
                                </label>
                                <input type="text" name="Author" id="Author" class="form-control" 
                                       placeholder="Tên người viết" />
                            </div>

                            <div>
                                <label class="form-label small fw-semibold text-muted">
                                    <i class="fa fa-link me-1"></i>Nguồn
                                </label>
                                <input type="text" name="Source" id="Source" class="form-control" 
                                       placeholder="VD: Bộ Y tế, WHO..." />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 shadow-sm"
                            style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;"
                            onclick="return submitForm()">
                        <i class="fa fa-paper-plane me-2"></i>Xuất bản bài viết
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

<style>
    .cursor-pointer {
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.15);
    }
</style>

@section Scripts {
    <script>
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Bắt đầu viết nội dung bài viết của bạn...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['link', 'image'],
                    ['blockquote', 'code-block'],
                    ['clean']
                ]
            }
        });

        function submitForm() {
            var content = quill.root.innerHTML;
            document.getElementById('Content').value = content;
            
            var title = document.getElementById('Title').value.trim();
            if (!title) {
                alert('Vui lòng nhập tiêu đề bài viết.');
                document.getElementById('Title').focus();
                return false;
            }
            
            if (quill.getText().trim().length < 10) {
                alert('Vui lòng nhập nội dung bài viết (ít nhất 10 ký tự).');
                return false;
            }
            
            return true;
        }

        function previewImage(input, imgId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById(imgId).src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
