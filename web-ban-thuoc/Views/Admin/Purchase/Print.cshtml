@model web_ban_thuoc.Models.PurchaseOrderPrintViewModel
@{
    ViewData["Title"] = "In đơn đặt hàng";
    Layout = null;
    var printedAt = ViewBag.PrintedAt ?? DateTime.Now;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.OrderCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --brand: #1250dc;
            --brand-light: #e7eefc;
        }
        body {
            background: #f3f4f6;
            color: #111827;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        }
        .paper {
            max-width: 900px;
            margin: 24px auto;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        /* Header */
        .print-header {
            background: var(--brand);
            color: #fff;
        }
        .header-brand {
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.12);
        }
        .header-brand img {
            height: 42px;
        }
        .header-contact {
            text-align: right;
            font-size: 0.82rem;
            line-height: 1.7;
            opacity: 0.9;
        }
        .header-info {
            padding: 10px 24px;
            font-size: 0.8rem;
            opacity: 0.8;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.10);
        }
        .header-doc {
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Content */
        .section-title {
            color: #1f2937;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 12px;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--brand-light);
        }
        .muted { color: #6b7280; }
        .table th {
            background: #f1f5f9;
            color: #374151;
            font-weight: 600;
        }
        .table td, .table th {
            padding: 8px 12px;
        }
        .receipt-card {
            background: #f8faff;
            border: 1px solid var(--brand-light);
            border-radius: 12px;
            padding: 12px;
        }

        /* Footer */
        .footer-bar {
            background: #f8fafc;
            border-top: 1px solid #e3e9f7;
            padding: 12px 24px;
            font-size: 0.8rem;
            color: #6b7280;
        }

        /* Print */
        @@media print {
            body { background: #fff; }
            .no-print { display: none !important; }
            .paper { margin: 0; box-shadow: none; border-radius: 0; }
        }
    </style>
</head>
<body>
    <div class="paper">
        <!-- Header -->
        <div class="print-header">
            <div class="header-brand">
                <img src="/images/default/header_logo_brand.png" alt="Long Châu Logo" />
                <div class="header-contact">
                    <div><i class="fa fa-phone me-1"></i>1900 1234</div>
                    <div><i class="fa fa-globe me-1"></i>longchau.vn</div>
                    <div><i class="fa fa-envelope me-1"></i>cskh@longchau.vn</div>
                </div>
            </div>
            <div class="header-info">
                <div>
                    <i class="fa fa-building me-1"></i> Nhà Thuốc Long Châu
                    <span class="mx-2">·</span>
                    <i class="fa fa-map-marker-alt me-1"></i>123 Đường ABC, Quận 1, TP.HCM
                </div>
                <div>
                    <i class="fa fa-clock me-1"></i>In lúc: @printedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <div class="header-doc">
                <div>
                    <h1 class="h4 fw-bold mb-0"><i class="fa fa-file-invoice me-2"></i>Đơn đặt hàng NCC</h1>
                    <div class="small opacity-75 mt-1">Mã đơn: <strong>@Model.OrderCode</strong></div>
                </div>
                <div>
                    <span class="badge @(Model.Status == "Đã xác nhận" ? "bg-success" : Model.Status == "Đã hủy" ? "bg-danger" : "bg-warning text-dark") px-3 py-2">
                        @Model.Status
                    </span>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="p-4">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="section-title"><i class="fa fa-truck me-1" style="color:var(--brand)"></i> Nhà cung cấp</div>
                            <div class="fw-semibold">@Model.SupplierName</div>
                            <div class="small text-muted">Mã: @Model.SupplierCode</div>
                            @if (!string.IsNullOrWhiteSpace(Model.SupplierTaxCode))
                            {
                                <div class="small text-muted">Mã số thuế: @Model.SupplierTaxCode</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SupplierPhone))
                            {
                                <div class="small text-muted">Điện thoại: @Model.SupplierPhone</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SupplierEmail))
                            {
                                <div class="small text-muted">Email: @Model.SupplierEmail</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SupplierAddress))
                            {
                                <div class="small text-muted">Địa chỉ: @Model.SupplierAddress</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="section-title"><i class="fa fa-warehouse me-1" style="color:var(--brand)"></i> Kho nhận</div>
                            <div class="fw-semibold">@Model.WarehouseName</div>
                            @if (!string.IsNullOrWhiteSpace(Model.WarehouseAddress))
                            {
                                <div class="small text-muted">Địa chỉ: @Model.WarehouseAddress</div>
                            }
                            <div class="small text-muted">Đặt hàng: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                            @if (Model.ExpectedDate.HasValue)
                            {
                                <div class="small text-muted">Dự kiến nhận: @Model.ExpectedDate.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="alert alert-light border mb-3"><strong>Ghi chú:</strong> @Model.Note</div>
            }

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold"><i class="fa fa-list-ul me-1" style="color:var(--brand)"></i> Chi tiết đặt hàng</div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Sản phẩm</th>
                                <th class="text-center">SL đặt</th>
                                <th class="text-center">Đã nhận</th>
                                <th class="text-center">Còn lại</th>
                                <th class="text-end">Giá nhập</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines.Select((value, idx) => new { value, idx }))
                            {
                                <tr>
                                    <td>@(line.idx + 1)</td>
                                    <td>
                                        <div class="fw-semibold">@line.value.ProductName</div>
                                        <div class="small muted">SKU: @(line.value.Sku ?? "—")</div>
                                    </td>
                                    <td class="text-center">@line.value.QuantityOrdered</td>
                                    <td class="text-center text-success">@line.value.QuantityReceived</td>
                                    <td class="text-center">@line.value.RemainingQuantity</td>
                                    <td class="text-end">@line.value.UnitCost.ToString("N0")đ</td>
                                    <td class="text-end fw-semibold">@line.value.LineValue.ToString("N0")đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td colspan="3">Tổng</td>
                                <td class="text-center text-success">@Model.TotalReceived</td>
                                <td class="text-center text-danger">@Model.TotalRemaining</td>
                                <td class="text-end"></td>
                                <td class="text-end">@Model.TotalValue.ToString("N0")đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @if (Model.Receipts.Any())
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold"><i class="fa fa-clock-rotate-left me-1" style="color:var(--brand)"></i> Lịch sử nhận hàng</div>
                    <div class="card-body">
                        @foreach (var receipt in Model.Receipts.Select((value, idx) => new { value, idx }))
                        {
                            <div class="receipt-card mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <strong>Đợt @(receipt.idx + 1) · @receipt.value.ReceiptCode</strong>
                                        <div class="small muted">@receipt.value.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-success-subtle text-success">@receipt.value.TotalQuantity SP</span>
                                        <div class="fw-semibold">@receipt.value.TotalValue.ToString("N0")đ</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(receipt.value.Note))
                                {
                                    <div class="small text-muted mb-1">Ghi chú: @receipt.value.Note</div>
                                }
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Sản phẩm</th>
                                                <th>Lô</th>
                                                <th>HSD</th>
                                                <th class="text-end">SL</th>
                                                <th class="text-end">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in receipt.value.Lines)
                                            {
                                                <tr>
                                                    <td>@line.ProductName</td>
                                                    <td><span class="badge bg-light text-dark border">@line.BatchNo</span></td>
                                                    <td>@(line.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                    <td class="text-end">@line.Quantity</td>
                                                    <td class="text-end">@line.LineValue.ToString("N0")đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center no-print">
                <button onclick="window.print()" class="btn btn-dark"><i class="fa fa-print me-1"></i> In phiếu</button>
                <a href="/AdminPurchase/Details/@Model.OrderCode.Replace("/", "-")" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-bar d-flex justify-content-between align-items-center">
            <div>
                <i class="fa fa-building me-1"></i> Nhà Thuốc Long Châu
                <span class="mx-2">·</span>
                <i class="fa fa-globe me-1"></i>longchau.vn
                <span class="mx-2">·</span>
                <i class="fa fa-envelope me-1"></i>cskh@longchau.vn
            </div>
            <div>Trang 1 / 1</div>
        </div>
    </div>
</body>
</html>
