@model web_ban_thuoc.Models.StockAdjustmentDetailPageViewModel
@using web_ban_thuoc.Models
@{
    ViewData["Title"] = "Chi tiết phiếu điều chỉnh";
    Layout = null;
    var sa = Model.Adjustment;
    var printedAt = ViewBag.PrintedAt ?? DateTime.Now;
    var reasonDisplay = StockAdjustmentReasons.All.TryGetValue(sa.Reason ?? "", out var r) ? r : (sa.Reason ?? "—");

    string StatusBadge(string s) => s switch
    {
        var x when x == StockAdjustmentStatuses.Pending => "bg-warning text-dark",
        var x when x == StockAdjustmentStatuses.Approved => "bg-success",
        var x when x == StockAdjustmentStatuses.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    string TypeLabel(string s) => s switch
    {
        StockAdjustmentTypes.Export => "PHIẾU XUẤT KHO",
        StockAdjustmentTypes.Import => "PHIẾU NHẬP KHO",
        StockAdjustmentTypes.Positive => "PHIẾU ĐIỀU CHỈNH TĂNG",
        StockAdjustmentTypes.Negative => "PHIẾU ĐIỀU CHỈNH GIẢM",
        _ => "PHIẾU ĐIỀU CHỈNH TỒN KHO"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@sa.AdjustmentCode – Phiếu điều chỉnh tồn kho</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --brand: #1250dc;
            --brand-light: #e7eefc;
        }
        body {
            background: #f3f4f6;
            color: #111827;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        }
        .paper {
            max-width: 900px;
            margin: 24px auto;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        /* Header */
        .print-header {
            background: var(--brand);
            color: #fff;
        }
        .header-brand {
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.12);
        }
        .header-brand img {
            height: 42px;
        }
        .header-contact {
            text-align: right;
            font-size: 0.82rem;
            line-height: 1.7;
            opacity: 0.9;
        }
        .header-info {
            padding: 10px 24px;
            font-size: 0.8rem;
            opacity: 0.8;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.10);
        }
        .header-doc {
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Content */
        .section-title {
            color: #1f2937;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 12px;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--brand-light);
        }
        .muted { color: #6b7280; }
        .table th {
            background: #f1f5f9;
            color: #374151;
            font-weight: 600;
        }
        .table td, .table th {
            padding: 8px 12px;
        }

        /* Footer */
        .footer-bar {
            background: #f8fafc;
            border-top: 1px solid #e3e9f7;
            padding: 12px 24px;
            font-size: 0.8rem;
            color: #6b7280;
        }

        /* Print */
        @@media print {
            body { background: #fff; }
            .no-print { display: none !important; }
            .paper { margin: 0; box-shadow: none; border-radius: 0; }
        }
    </style>
</head>
<body>
    <div class="paper">
        <!-- Header -->
        <div class="print-header">
            <div class="header-brand">
                <img src="/images/default/header_logo_brand.png" alt="Long Châu Logo" />
                <div class="header-contact">
                    <div><i class="fa fa-phone me-1"></i>1900 1234</div>
                    <div><i class="fa fa-globe me-1"></i>longchau.vn</div>
                    <div><i class="fa fa-envelope me-1"></i>cskh@longchau.vn</div>
                </div>
            </div>
            <div class="header-info">
                <div>
                    <i class="fa fa-building me-1"></i> Nhà Thuốc Long Châu
                    <span class="mx-2">·</span>
                    <i class="fa fa-map-marker-alt me-1"></i>123 Đường ABC, Quận 1, TP.HCM
                </div>
                <div>
                    <i class="fa fa-clock me-1"></i>In lúc: @printedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <div class="header-doc">
                <div>
                    <h1 class="h4 fw-bold mb-0"><i class="fa fa-file-invoice me-2"></i>Phiếu điều chỉnh tồn kho</h1>
                    <div class="small opacity-75 mt-1">Mã phiếu: <strong>@sa.AdjustmentCode</strong></div>
                </div>
                <div>
                    <span class="badge @StatusBadge(sa.Status) px-3 py-2">@sa.Status</span>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="p-4">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="section-title"><i class="fa fa-warehouse me-1" style="color:var(--brand)"></i> Kho</div>
                            <div class="fw-semibold">@sa.Warehouse.Name</div>
                            <div class="small text-muted">Ngày tạo: @sa.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="small text-muted">Người yêu cầu: @(sa.RequestedBy ?? "—")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="section-title"><i class="fa fa-circle-info me-1" style="color:var(--brand)"></i> Thông tin phiếu</div>
                            <div class="small text-muted">Loại: <span class="fw-semibold text-dark">@StockAdjustmentTypes.DisplayName(sa.AdjustmentType)</span></div>
                            <div class="small text-muted">Lý do: <span class="fw-semibold text-dark">@reasonDisplay</span></div>
                            <div class="small text-muted">Người xử lý: <span class="fw-semibold text-dark">@(sa.ApprovedBy ?? "—")</span></div>
                            @if (sa.ProcessedAt.HasValue)
                            {
                                <div class="small text-muted">Ngày xử lý: <span class="fw-semibold text-dark">@sa.ProcessedAt.Value.ToString("dd/MM/yyyy HH:mm")</span></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(sa.Note))
            {
                <div class="alert alert-light border mb-3"><strong>Ghi chú:</strong> @sa.Note</div>
            }

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold"><i class="fa fa-list-ul me-1" style="color:var(--brand)"></i> Chi tiết phiếu</div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Sản phẩm</th>
                                <th>Mã lô</th>
                                <th>HSD</th>
                                <th class="text-end">SL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var stt = 0;
                                var isExport = sa.AdjustmentType == StockAdjustmentTypes.Export || sa.AdjustmentType == StockAdjustmentTypes.Negative;
                            }
                            @foreach (var d in Model.Details)
                            {
                                stt++;
                                <tr>
                                    <td>@stt</td>
                                    <td>
                                        <div class="fw-semibold">@d.ProductName</div>
                                        <div class="small muted">SKU: @(d.Sku ?? "—")</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.BatchNo))
                                        {
                                            <span class="badge bg-light text-dark border">@d.BatchNo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">FEFO tự động</span>
                                        }
                                    </td>
                                    <td>@(d.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td class="text-end fw-semibold @(isExport ? "text-danger" : "text-success")">
                                        @(isExport ? "-" : "+")@d.Quantity
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                                <td class="text-end">@(sa.AdjustmentType == StockAdjustmentTypes.Export || sa.AdjustmentType == StockAdjustmentTypes.Negative ? "-" : "+")@Model.Details.Sum(d => d.Quantity)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center no-print">
                <a href="/AdminInventory/StockAdjustments" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Quay lại
                </a>
                <div class="d-flex gap-2">
                    @if (sa.Status == StockAdjustmentStatuses.Pending)
                    {
                        <form method="post" action="/AdminInventory/ApproveStockAdjustment/@sa.StockAdjustmentId" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success"
                                    onclick="return confirm('Duyệt phiếu này? Tồn kho sẽ được cập nhật ngay.')">
                                <i class="fa fa-check me-1"></i> Duyệt phiếu
                            </button>
                        </form>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="fa fa-xmark me-1"></i> Từ chối
                        </button>
                    }
                    @if (sa.Status == StockAdjustmentStatuses.Approved)
                    {
                        <a href="/AdminInventory/PrintStockAdjustment/@sa.StockAdjustmentId" target="_blank" class="btn btn-dark">
                            <i class="fa fa-print me-1"></i> In phiếu
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-bar d-flex justify-content-between align-items-center">
            <div>
                <i class="fa fa-building me-1"></i> Nhà Thuốc Long Châu
                <span class="mx-2">·</span>
                <i class="fa fa-globe me-1"></i>longchau.vn
                <span class="mx-2">·</span>
                <i class="fa fa-envelope me-1"></i>cskh@longchau.vn
            </div>
            <div>Trang 1 / 1</div>
        </div>
    </div>

    <!-- Modal từ chối -->
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="/AdminInventory/RejectStockAdjustment/@sa.StockAdjustmentId">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fa fa-xmark text-danger me-1"></i> Từ chối phiếu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Bạn có chắc muốn từ chối phiếu <strong>@sa.AdjustmentCode</strong>?</p>
                        <div class="mb-3">
                            <label class="form-label">Lý do từ chối</label>
                            <textarea class="form-control" name="reason" rows="3" placeholder="VD: Không đủ hàng trong kho..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger">Từ chối</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
