@model web_ban_thuoc.Models.StockAdjustmentDetailPageViewModel
@using web_ban_thuoc.Models
@{
    ViewData["Title"] = "Chi tiết phiếu điều chỉnh";
    Layout = "~/Views/Admin/_Layout.cshtml";

    var sa = Model.Adjustment;

    string StatusBadge(string s) => s switch
    {
        var x when x == StockAdjustmentStatuses.Pending => "bg-warning text-dark",
        var x when x == StockAdjustmentStatuses.Approved => "bg-success",
        var x when x == StockAdjustmentStatuses.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    string TypeBadge(string s) => s switch
    {
        StockAdjustmentTypes.Export => "bg-danger-subtle text-danger",
        StockAdjustmentTypes.Import => "bg-success-subtle text-success",
        StockAdjustmentTypes.Positive => "bg-success-subtle text-success",
        StockAdjustmentTypes.Negative => "bg-warning-subtle text-warning",
        _ => "bg-secondary"
    };

    var reasonDisplay = StockAdjustmentReasons.All.TryGetValue(sa.Reason ?? "", out var r) ? r : (sa.Reason ?? "—");
}

<div class="container-fluid py-3">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4">@TempData["ErrorMessage"]</div>
    }

    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="p-4 text-white" style="background:linear-gradient(135deg,#dc3535,#f57c00);">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fa fa-file-invoice fa-lg"></i>
                        <h4 class="fw-bold mb-0">@sa.AdjustmentCode</h4>
                        <span class="badge @StatusBadge(sa.Status) ms-2">@sa.Status</span>
                        <span class="badge bg-dark bg-opacity-50 ms-1">@StockAdjustmentTypes.DisplayName(sa.AdjustmentType)</span>
                    </div>
                    <div class="opacity-75 small">
                        <i class="fa fa-warehouse me-1"></i> @sa.Warehouse.Name
                        <span class="mx-2">·</span>
                        <i class="fa fa-calendar me-1"></i> @sa.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        <span class="mx-2">·</span>
                        <i class="fa fa-user me-1"></i> Yêu cầu: @(sa.RequestedBy ?? "—")
                    </div>
                </div>
                <div class="text-end">
                    <div class="opacity-75 small">Tổng số dòng</div>
                    <div class="fs-4 fw-bold">@Model.Details.Count</div>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(sa.Note))
            {
                <div class="alert alert-light border rounded-3 mb-3">
                    <i class="fa fa-note-sticky text-muted me-1"></i> <strong>Ghi chú:</strong> @sa.Note
                </div>
            }
            <div class="d-flex flex-wrap gap-2">
                @if (sa.Status == StockAdjustmentStatuses.Pending)
                {
                    <form method="post" action="/AdminInventory/ApproveStockAdjustment/@sa.StockAdjustmentId" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success"
                                onclick="return confirm('Duyệt phiếu này? Tồn kho sẽ được cập nhật ngay.')">
                            <i class="fa fa-check me-1"></i> Duyệt phiếu
                        </button>
                    </form>
                    <button type="button" class="btn btn-danger" onclick="showRejectModal()">
                        <i class="fa fa-xmark me-1"></i> Từ chối
                    </button>
                }
                @if (sa.Status == StockAdjustmentStatuses.Approved)
                {
                    <a href="/AdminInventory/PrintStockAdjustment/@sa.StockAdjustmentId" target="_blank" class="btn btn-dark">
                        <i class="fa fa-print me-1"></i> In phiếu
                    </a>
                }
                <a href="/AdminInventory/StockAdjustments" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Thông tin phiếu -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white fw-semibold rounded-top-4">
                    <i class="fa fa-info-circle text-primary me-1"></i> Thông tin phiếu
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td class="text-muted">Mã phiếu</td>
                            <td class="fw-semibold">@sa.AdjustmentCode</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Loại</td>
                            <td><span class="badge @TypeBadge(sa.AdjustmentType)">@StockAdjustmentTypes.DisplayName(sa.AdjustmentType)</span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Lý do</td>
                            <td>@reasonDisplay</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Kho</td>
                            <td>@sa.Warehouse.Name</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Người yêu cầu</td>
                            <td>@(sa.RequestedBy ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Người xử lý</td>
                            <td>@(sa.ApprovedBy ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ngày tạo</td>
                            <td>@sa.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        @if (sa.ProcessedAt.HasValue)
                        {
                            <tr>
                                <td class="text-muted">Ngày xử lý</td>
                                <td>@sa.ProcessedAt.Value.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                        <tr>
                            <td class="text-muted">Trạng thái</td>
                            <td><span class="badge @StatusBadge(sa.Status)">@sa.Status</span></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- In phiếu -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white fw-semibold rounded-top-4">
                    <i class="fa fa-print text-primary me-1"></i> In ấn
                </div>
                <div class="card-body">
                    <a href="/AdminInventory/PrintStockAdjustment/@sa.StockAdjustmentId" target="_blank"
                       class="btn btn-dark w-100 mb-2">
                        <i class="fa fa-print me-1"></i> In phiếu điều chỉnh
                    </a>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white fw-semibold rounded-top-4 d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-boxes-stacked text-primary me-1"></i> Danh sách sản phẩm</span>
                    <span class="badge bg-primary-subtle text-primary">@Model.Details.Count dòng</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Mã lô</th>
                                <th>HSD</th>
                                <th class="text-center">SL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Details)
                            {
                                var expiringSoon = d.ExpiryDate.HasValue && d.ExpiryDate.Value <= DateTime.Today.AddDays(90);
                                var expired = d.ExpiryDate.HasValue && d.ExpiryDate.Value < DateTime.Today;
                                <tr class="@(expired ? "table-danger" : expiringSoon ? "table-warning" : "")">
                                    <td>
                                        <div class="fw-semibold">@d.ProductName</div>
                                        <div class="small text-muted font-monospace">@(d.Sku ?? "—")</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.BatchNo))
                                        {
                                            <span class="badge bg-light text-dark border">@d.BatchNo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">— (FEFO tự động)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (d.ExpiryDate.HasValue)
                                        {
                                            var days = (d.ExpiryDate.Value - DateTime.Today).TotalDays;
                                            <span class="small @(expired ? "text-danger fw-bold" : expiringSoon ? "text-warning-emphasis" : "")">
                                                @d.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                            </span>
                                            @if (expired)
                                            {
                                                <span class="badge bg-danger ms-1">Đã hết</span>
                                            }
                                            else if (days <= 30)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">@days ngày</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold @(sa.AdjustmentType == StockAdjustmentTypes.Export || sa.AdjustmentType == StockAdjustmentTypes.Negative ? "text-danger" : "text-success")">
                                        @(sa.AdjustmentType == StockAdjustmentTypes.Export || sa.AdjustmentType == StockAdjustmentTypes.Negative ? "-" : "+")@d.Quantity
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Tổng số lượng</td>
                                <td class="text-center">
                                    @(sa.AdjustmentType == StockAdjustmentTypes.Export || sa.AdjustmentType == StockAdjustmentTypes.Negative ? "-" : "+")@Model.Details.Sum(d => d.Quantity)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal từ chối -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/AdminInventory/RejectStockAdjustment/@sa.StockAdjustmentId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-xmark text-danger me-1"></i> Từ chối phiếu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc muốn từ chối phiếu <strong>@sa.AdjustmentCode</strong>?</p>
                    <div class="mb-3">
                        <label class="form-label">Lý do từ chối</label>
                        <textarea class="form-control" name="reason" rows="3" placeholder="VD: Không đủ hàng trong kho..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function showRejectModal() {
    var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
    modal.show();
}
</script>
}
