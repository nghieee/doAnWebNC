@model web_ban_thuoc.Models.HomeViewModel

@{
    ViewData["Title"] = "Nhà Thuốc Long Châu - Trang chủ";
}

<!-- Full-Width Carousel -->
@if (Model.Banners.Any())
{
    var fullWidthBanners = Model.Banners.Where(b => b.BannerType != null && b.BannerType.Equals("FullWidth", StringComparison.OrdinalIgnoreCase)).ToList();
    if (fullWidthBanners.Any())
    {
        <div id="fullWidthCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < fullWidthBanners.Count; i++)
                {
                    var banner = fullWidthBanners[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        @if (!string.IsNullOrEmpty(banner.LinkUrl))
                        {
                            <a href="@banner.LinkUrl" target="_blank">
                                <img src="@banner.ImageUrl" class="d-block w-100" alt="@banner.Title"
                                    style="object-fit: cover; min-height: 240px; background: #e9ecef;" />
                            </a>
                        }
                        else
                        {
                            <img src="@banner.ImageUrl" class="d-block w-100" alt="@banner.Title"
                                style="object-fit: cover; min-height: 240px; background: #e9ecef;" />
                        }
                    </div>
                }
            </div>
            @if (fullWidthBanners.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#fullWidthCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#fullWidthCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
                <div class="carousel-indicators">
                    @for (int i = 0; i < fullWidthBanners.Count; i++)
                    {
                        <button type="button" data-bs-target="#fullWidthCarousel" data-bs-slide-to="@i" 
                            class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" 
                            aria-label="Slide @(i + 1)"></button>
                    }
                </div>
            }
        </div>
    }
}

<!-- TwoThirds + OneThird Banners -->
@if (Model.Banners.Any())
{
    var twoThirdsBanners = Model.Banners.Where(b => b.BannerType != null && b.BannerType.Equals("TwoThirds", StringComparison.OrdinalIgnoreCase)).ToList();
    var oneThirdBanners = Model.Banners.Where(b => b.BannerType != null && b.BannerType.Equals("OneThird", StringComparison.OrdinalIgnoreCase)).ToList();
    if (twoThirdsBanners.Any() || oneThirdBanners.Any())
    {
        <div class="mx-auto pt-4">
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-8">
                    @if (twoThirdsBanners.Any())
                    {
                        <div id="twoThirdsCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for (int i = 0; i < twoThirdsBanners.Count; i++)
                                {
                                    var banner = twoThirdsBanners[i];
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        @if (!string.IsNullOrEmpty(banner.LinkUrl))
                                        {
                                            <a href="@banner.LinkUrl" target="_blank">
                                                <img src="@banner.ImageUrl" class="d-block w-100 rounded-3" alt="@banner.Title"
                                                    style="object-fit: cover;" />
                                            </a>
                                        }
                                        else
                                        {
                                            <img src="@banner.ImageUrl" class="d-block w-100 rounded-3" alt="@banner.Title"
                                                style="object-fit: cover;" />
                                        }
                                    </div>
                                }
                            </div>
                            @if (twoThirdsBanners.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#twoThirdsCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#twoThirdsCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                                <div class="carousel-indicators">
                                    @for (int i = 0; i < twoThirdsBanners.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#twoThirdsCarousel" data-bs-slide-to="@i" 
                                            class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" 
                                            aria-label="Slide @(i + 1)"></button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="col-12 col-lg-4">
                    @if (oneThirdBanners.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var banner in oneThirdBanners)
                            {
                                <div class="one-third-banner-item">
                                    @if (!string.IsNullOrEmpty(banner.LinkUrl))
                                    {
                                        <a href="@banner.LinkUrl" target="_blank">
                                            <img src="@banner.ImageUrl" class="d-block w-100 rounded-3" alt="@banner.Title" />
                                        </a>
                                    }
                                    else
                                    {
                                        <img src="@banner.ImageUrl" class="d-block w-100 rounded-3" alt="@banner.Title" />
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<!-- Feature Categories -->
<div class="mx-auto pt-4">
    <div class="d-flex align-items-center mb-2 font-medium text-black text-lg">
        <img src="/images/danh_muc_noi_bat.png" width="24" height="24" class="me-2" alt="Danh mục nổi bật" />
        Danh mục nổi bật
    </div>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-6 g-4 justify-content-center">
        @foreach (var cat in Model.FeaturedCategories)
        {
            <div class="col">
                <a href="/Categories/@cat.CategoryId"
                    class="text-decoration-none text-black bg-white p-4 rounded-3 shadow-sm text-center d-block hover-bg-light transition"
                    style="min-height: 120px; display: flex; flex-direction: column; justify-content: center;">
                    <img src="/images/categories/@(cat.ImageUrl ?? "/images/placeholder.png")" width="24"
                        height="24" class="mx-auto mb-2" alt="@cat.CategoryName" />
                    <div class="mt-2 font-medium" style="height: 42px;">@cat.CategoryName</div>
                    <div class="text-gray-500 text-sm opacity-50">@cat.ProductCount sản phẩm</div>
                </a>
            </div>
        }
        @if (!Model.FeaturedCategories.Any())
        {
            <div class="col-12 text-center text-muted">Không có danh mục nổi bật nào.</div>
        }
    </div>
</div>

<!-- Products -->
<div class="pt-4">
    <div class="mx-auto">
        <div class="d-flex align-items-center mb-2 font-medium text-black text-lg">
            <img src="/images/danh_muc_noi_bat.png" width="24" height="24" class="me-2" alt="Danh mục nổi bật" />
            Sản phẩm nổi bật
        </div>
        <div class="row row-cols-1 row-cols-md-6 g-4 justify-content-center">
            @foreach (var product in Model.FeaturedProducts)
            {
                var mainImage = product.ProductImages?.FirstOrDefault(i => i.IsMain == true) ??
                product.ProductImages?.FirstOrDefault();
                <a class="col text-decoration-none"
                    href="@Url.Action("Details", "Product", new { id = product.ProductId })">
                    <div class="bg-white rounded-3 shadow-sm overflow-hidden hover-border hover-border-blue-500 h-100">
                        <img src="/images/products/@(mainImage?.ImageUrl ?? "/images/sanpham.png")" class="p-3 w-100"
                            alt="@product.ProductName" />
                        <div class="px-3 pb-3">
                            <h5 class="text-sm text-black line-clamp-3">@product.ProductName</h5>
                            <div class="mt-1 text-primary fw-semibold">@product.Price.ToString("N0")đ</div>
                            <div class="text-gray-500 text-sm text-decoration-line-through opacity-50">@((product.Price *
                                                            1.25m).ToString("N0"))đ</div>
                            <p class="mt-1 bg-gray-200 text-gray-600 rounded text-xs w-fit opacity-50">@(product.Package ??
                                                            "Hộp")</p>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" style="margin-top:8px;" class="add-to-cart-form">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-primary w-100 rounded-pill">Thêm vào giỏ</button>
                            </form>
                        </div>
                    </div>
                </a>
            }
            @if (!Model.FeaturedProducts.Any())
            {
                <div class="col-12 text-center text-muted">Không có sản phẩm nổi bật nào.</div>
            }
        </div>
    </div>
</div>

<!-- Doctor Section -->
@if (Model.FeaturedNews.Any())
{
    var mainNews = Model.FeaturedNews.First();
    <div class="mx-auto mt-4 pb-4">
        <div class="d-flex align-items-center mb-3">
            <img src="/images/danh_muc_noi_bat.png" width="24" height="24" class="me-2" alt="Góc sức khỏe" />
            <span class="fw-semibold text-dark" style="font-size: 1.125rem;">Góc sức khỏe</span>
        </div>

        <!-- Featured article -->
        <a href="/News/Details/@mainNews.NewsId" class="text-decoration-none d-block mb-3">
            <div class="position-relative overflow-hidden rounded-4 health-featured border shadow-sm"
                 style="background: white; min-height: 280px;">
                <div class="row g-0 h-100">
                    @if (!string.IsNullOrEmpty(mainNews.ImageUrl))
                    {
                        <div class="col-md-5">
                            <img src="@mainNews.ImageUrl" class="w-100 h-100"
                                 alt="@mainNews.Title" style="object-fit: cover; min-height: 280px;" />
                        </div>
                        <div class="col-md-7 d-flex align-items-center p-4">
                            <div class="text-dark">
                                @if (!string.IsNullOrEmpty(mainNews.Category))
                                {
                                    <span class="badge bg-light text-primary mb-2" style="font-size: 0.75rem;">@mainNews.Category</span>
                                }
                                <h3 class="fw-bold mb-2" style="font-size: 1.3rem; line-height: 1.3;">@mainNews.Title</h3>
                                @if (!string.IsNullOrEmpty(mainNews.Summary))
                                {
                                    <p class="mb-3 text-muted" style="font-size: 0.9rem; line-height: 1.6;">@mainNews.Summary</p>
                                }
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    @if (!string.IsNullOrEmpty(mainNews.Author))
                                    {
                                        <span><i class="fa fa-user me-1"></i>@mainNews.Author</span>
                                    }
                                    <span><i class="fa fa-eye me-1"></i>@mainNews.ViewCount lượt xem</span>
                                    <span><i class="fa fa-calendar me-1"></i>@((mainNews.PublishedAt ?? mainNews.CreatedAt).ToString("dd/MM/yyyy"))</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12 d-flex align-items-center p-4">
                            <div class="text-dark">
                                @if (!string.IsNullOrEmpty(mainNews.Category))
                                {
                                    <span class="badge bg-light text-primary mb-2" style="font-size: 0.75rem;">@mainNews.Category</span>
                                }
                                <h3 class="fw-bold mb-2" style="font-size: 1.3rem; line-height: 1.3;">@mainNews.Title</h3>
                                @if (!string.IsNullOrEmpty(mainNews.Summary))
                                {
                                    <p class="mb-3 text-muted" style="font-size: 0.9rem; line-height: 1.6;">@mainNews.Summary</p>
                                }
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    @if (!string.IsNullOrEmpty(mainNews.Author))
                                    {
                                        <span><i class="fa fa-user me-1"></i>@mainNews.Author</span>
                                    }
                                    <span><i class="fa fa-calendar me-1"></i>@((mainNews.PublishedAt ?? mainNews.CreatedAt).ToString("dd/MM/yyyy"))</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </a>

        <!-- Side articles -->
        @{
            var sideNews = Model.FeaturedNews.Skip(1).ToList();
        }
        @if (sideNews.Any())
        {
            <div class="row g-3">
                @foreach (var item in sideNews)
                {
                    <div class="col-md-4">
                        <a href="/News/Details/@item.NewsId" class="text-decoration-none">
                            <div class="card border-0 shadow-sm rounded-3 h-100 health-card">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title"
                                         style="height: 160px; object-fit: cover;" />
                                }
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(item.Category))
                                    {
                                        <span class="badge bg-primary-subtle text-primary mb-2" style="font-size: 0.7rem;">@item.Category</span>
                                    }
                                    <h6 class="fw-semibold text-dark line-clamp-2" style="font-size: 0.95rem;">@item.Title</h6>
                                    <p class="card-text small text-muted line-clamp-2">@item.Summary</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <small class="text-muted">
                                        <i class="fa fa-calendar me-1"></i>@((item.PublishedAt ?? item.CreatedAt).ToString("dd/MM/yyyy"))
                                    </small>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }

        <!-- View all link -->
        <div class="text-center mt-3">
            <a href="/News" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fa fa-newspaper-o me-1"></i>Xem tất cả bài viết
            </a>
        </div>
    </div>
}

@if (ViewBag.ShowGiftPopup == true)
{
    <div id="gift-popup-overlay" style="position:fixed;z-index:2000;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;">
        <div id="gift-popup-box" style="background:transparent;border:none;box-shadow:none;">
            <img src="/images/default/gift.png" alt="Quà tặng" id="gift-img" style="width:220px;cursor:pointer;animation:shakeGift 1s infinite alternate;z-index:3000;position:relative;">
        </div>
    </div>
    <style>
        @@keyframes shakeGift {
            0% { transform: rotate(-8deg) scale(1.05); }
            50% { transform: rotate(8deg) scale(1.1); }
            100% { transform: rotate(-8deg) scale(1.05); }
        }
    </style>
}

<style>
    .hover-bg-light:hover {
        background-color: #f9fafb;
        transition: background-color 0.3s;
    }

    .hover-border:hover {
        outline: 1px solid;
        outline-offset: 0;
    }

    .hover-border-blue-500:hover {
        outline-color: #3b82f6;
    }

    .bg-image {
        background-size: cover;
        background-position: center;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Layout OneThird: 2 ảnh xếp dọc, sát nhau, giữ tỉ lệ ảnh gốc */
    .one-third-banner-item {
        width: 100%;
        overflow: hidden;
    }
    .one-third-banner-item img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
    }
    .one-third-banner-item:hover img {
        transform: scale(1.03);
    }
    .one-third-banner-item a {
        display: block;
        width: 100%;
    }

    .health-featured {
        transition: transform 0.25s, box-shadow 0.25s;
    }
    .health-featured:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.15);
    }

    .health-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .health-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important;
    }
</style>
@section Scripts {
<script>
$(function() {
    $('#gift-img').on('click', function() {
        showAlert('Bạn nhận được voucher, truy cập mục quà tặng để kiểm tra!', { icon: 'success' });
        $('#gift-popup-overlay').fadeOut(300);
        $.post('/Home/MarkGiftSeen', function(){});
    });
});
</script>
}