@model List<web_ban_thuoc.Models.CategoryMenuViewModel>

@{
    var categories = Model ?? new List<web_ban_thuoc.Models.CategoryMenuViewModel>();
}

<nav class="navbar-categories" role="navigation">
    @foreach (var parent in categories)
    {
        <div class="nm-parent"
             data-parent-id="@parent.CategoryId"
             onmouseenter="nmShow('@parent.CategoryId')"
             onmouseleave="nmHide('@parent.CategoryId')">
            <button class="nm-btn" type="button" aria-expanded="false">
                <span>@parent.CategoryName</span>
                <i class="fas fa-chevron-down nm-arrow"></i>
                <span class="nm-underline"></span>
            </button>

            <div class="nm-dropdown" id="nm-@parent.CategoryId">
                <div class="nm-inner">
                    <div class="nm-left" id="nm-children-@parent.CategoryId"></div>
                    <div class="nm-right">
                        <div class="nm-grandchildren-grid" id="nm-grandchildren-@parent.CategoryId"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</nav>

<style>
    /* === NAVBAR WRAPPER === */
    .navbar-categories {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0;
    }

    /* === PARENT ITEM === */
    .nm-parent {
        position: relative;
    }

    .nm-btn {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.75rem 1rem;
        background: transparent;
        border: none;
        outline: none;
        box-shadow: none;
        cursor: pointer;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        color: #1e293b;
        transition: color 0.2s, background-color 0.2s;
        white-space: nowrap;
        position: relative;
    }

    .nm-btn:hover {
        color: #2563eb;
        background-color: #f1f5f9;
    }

    .nm-arrow {
        font-size: 0.7rem;
        transition: transform 0.25s cubic-bezier(.4, 0, .2, 1), color 0.2s;
        color: #94a3b8;
    }

    .nm-parent:hover .nm-arrow {
        color: #2563eb;
        transform: rotate(180deg);
    }

    .nm-underline {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        height: 2px;
        width: 0;
        background: #2563eb;
        border-radius: 1px;
        transition: width 0.3s cubic-bezier(.4, 0, .2, 1);
    }

    .nm-parent:hover .nm-underline {
        width: calc(100% - 1rem);
    }

    /* === DROPDOWN === */
    .nm-dropdown {
        position: absolute;
        left: 50%;
        top: calc(100% + 0.5rem);
        transform: translateX(-50%);
        width: 860px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.10), 0 4px 16px rgba(0, 0, 0, 0.06);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
        transform: translateX(-50%) translateY(-8px);
        z-index: 1000;
        overflow: hidden;
    }

    .nm-parent:hover .nm-dropdown,
    .nm-parent:focus-within .nm-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .nm-inner {
        display: flex;
        min-height: 320px;
    }

    /* === LEFT COLUMN: CHILDREN === */
    .nm-left {
        width: 260px;
        border-right: 1px solid #f1f5f9;
        padding: 1.25rem 0;
        flex-shrink: 0;
        background: #fafbfc;
        border-radius: 15px 0 0 15px;
    }

    .nm-child-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 1.25rem;
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
        border-left: 3px solid transparent;
        color: #475569;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: 0 8px 8px 0;
        margin: 1px 6px;
        width: calc(100% - 12px);
    }

    .nm-child-item:hover,
    .nm-child-item.is-active {
        background-color: #eef2ff;
        border-left-color: #2563eb;
        color: #2563eb;
    }

    .nm-child-item img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        border-radius: 6px;
        background: #fff;
        flex-shrink: 0;
    }

    .nm-child-item img:not([src]), .nm-child-item img[src=""] {
        display: none;
    }

    .nm-child-name {
        flex: 1;
    }

    .nm-child-arrow {
        font-size: 0.7rem;
        color: #cbd5e1;
        transition: color 0.15s, transform 0.15s;
    }

    .nm-child-item:hover .nm-child-arrow,
    .nm-child-item.is-active .nm-child-arrow {
        color: #2563eb;
        transform: translateX(2px);
    }

    /* === RIGHT COLUMN: GRANDCHILDREN === */
    .nm-right {
        flex: 1;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .nm-grandchildren-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 1fr;
        gap: 0.625rem;
    }

    .nm-grandchild-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1rem 0.625rem 0.875rem;
        border-radius: 14px;
        text-decoration: none;
        transition: background-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
        border: 1px solid transparent;
    }

    .nm-grandchild-card:hover {
        background-color: #f8fafc;
        box-shadow: 0 4px 16px rgba(37, 99, 235, 0.08);
        border-color: #e0e7ff;
        transform: translateY(-2px);
    }

    .nm-grandchild-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #2563eb;
        overflow: hidden;
        flex-shrink: 0;
        margin-bottom: 0.625rem;
        transition: background 0.18s ease;
    }

    .nm-grandchild-card:hover .nm-grandchild-icon {
        background: #eef2ff;
    }

    .nm-grandchild-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
    }

    .nm-grandchild-name {
        font-size: 0.78rem;
        font-weight: 500;
        color: #475569;
        line-height: 1.4;
    }

    /* === EMPTY STATE === */
    .nm-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 0.875rem;
        padding: 2rem;
        text-align: center;
    }

    /* === RESPONSIVE === */
    @@media (max-width: 768px) {
        .nm-dropdown {
            width: 90vw;
            min-width: unset;
        }
        .nm-inner {
            flex-direction: column;
        }
        .nm-left {
            width: 100%;
            border-right: none;
            border-bottom: 1px solid #f1f5f9;
            border-radius: 0;
        }
        .nm-grandchildren-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

<script>
    const nmCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    function nmShow(parentId) {
        nmHideAll();
        const panel = document.getElementById('nm-' + parentId);
        if (panel) panel.style.visibility = 'visible';
        nmRenderChildren(parentId);
    }

    function nmHide(parentId) {
        const panel = document.getElementById('nm-' + parentId);
        if (panel) panel.style.visibility = 'hidden';
    }

    function nmHideAll() {
        document.querySelectorAll('.nm-dropdown').forEach(p => p.style.visibility = 'hidden');
    }

    function nmRenderChildren(parentId) {
        const parent = nmCategories.find(p => p.categoryId.toString() === parentId);
        const childrenContainer = document.getElementById('nm-children-' + parentId);
        const grandchildrenContainer = document.getElementById('nm-grandchildren-' + parentId);
        if (!childrenContainer || !grandchildrenContainer) return;

        const children = parent?.children || [];
        if (!children.length) {
            childrenContainer.innerHTML = '<div class="nm-empty">Không có danh mục con</div>';
            grandchildrenContainer.innerHTML = '<div class="nm-empty" style="grid-column:1/-1">Không có danh mục cháu</div>';
            return;
        }

        childrenContainer.innerHTML = children.map(child => {
            const imgSrc = child.imageUrl
                ? (child.imageUrl.startsWith('/images/') ? child.imageUrl : '/images/categories/' + child.imageUrl)
                : '';
            return `
                <a href="/Categories/${child.categoryId}" class="nm-child-item" data-child-id="${child.categoryId}">
                    ${imgSrc ? `<img src="${imgSrc}" alt="${child.categoryName}" />` : ''}
                    <span class="nm-child-name">${child.categoryName}</span>
                    <i class="fas fa-angle-right nm-child-arrow"></i>
                </a>
            `;
        }).join('');

        childrenContainer.querySelectorAll('.nm-child-item').forEach(item => {
            item.addEventListener('mouseenter', () => {
                nmHighlightChild(childrenContainer, item.dataset.childId);
                nmRenderGrandchildren(parentId, item.dataset.childId);
            });
        });

        nmRenderGrandchildren(parentId, children[0].categoryId.toString());
    }

    function nmRenderGrandchildren(parentId, childId) {
        const parent = nmCategories.find(p => p.categoryId.toString() === parentId);
        const child = parent?.children?.find(c => c.categoryId.toString() === childId);
        const container = document.getElementById('nm-grandchildren-' + parentId);
        if (!container) return;

        const grandchildren = child?.children || [];
        if (!grandchildren.length) {
            container.innerHTML = '<div class="nm-empty" style="grid-column:1/-1">Không có danh mục cháu</div>';
            return;
        }

        container.innerHTML = grandchildren.map(gc => {
            const imgSrc = gc.imageUrl
                ? (gc.imageUrl.startsWith('/images/') ? gc.imageUrl : '/images/categories/' + gc.imageUrl)
                : '';
            return `
                <a href="/Categories/${gc.categoryId}" class="nm-grandchild-card">
                    <div class="nm-grandchild-icon">
                        ${imgSrc ? `<img src="${imgSrc}" alt="${gc.categoryName}" />` : ''}
                    </div>
                    <span class="nm-grandchild-name">${gc.categoryName}</span>
                </a>
            `;
        }).join('');
    }

    function nmHighlightChild(container, childId) {
        container.querySelectorAll('.nm-child-item').forEach(item =>
            item.classList.toggle('is-active', item.dataset.childId === childId)
        );
    }
</script>
