@{
    var chatHistory = Context.Session.GetString("AiChatHistory");
    var messages = new List<ChatMessage>();
    if (!string.IsNullOrEmpty(chatHistory))
    {
        try
        {
            messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessage>>(chatHistory) ?? new List<ChatMessage>();
            Console.WriteLine($"Loaded {messages.Count} messages from session");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deserializing chat history: {ex.Message}");
            messages = new List<ChatMessage>();
        }
    }
    else
    {
        Console.WriteLine("No chat history found in session");
    }
}

<div id="ai-chat-fab" class="position-fixed bottom-0 start-0 m-4 ai-fab-container" style="z-index:9999;pointer-events:auto; width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;">
    <div class="ai-fab-pulse"></div>
    <img id="open-ai-chat" src="/images/default/ai-bot-doctor.png" alt="AI Bot Doctor" style="width:130px;cursor:pointer;pointer-events:auto; transition: transform 0.2s;" />
</div>

<div id="ai-chat-popup" class="position-fixed bottom-0 start-0 m-4 ai-chat-glass-popup" style="z-index:10000;width:400px;max-width:95vw;height: 560px; display: flex; flex-direction: column;">
    <!-- Glass Header -->
    <div id="ai-chat-header" class="ai-chat-glass-header text-white d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <img src="/images/default/ai-bot-doctor.png" alt="AI Bot Doctor" style="width:30px;height:30px;object-fit:contain; background: rgba(255,255,255,0.2); border-radius: 50%; padding: 2px;" />
            <div>
                <span class="fw-bold d-block" style="font-size: 1rem; letter-spacing: 0.3px; line-height: 1.2;">Dược sĩ AI Long Châu</span>
                <span class="small" style="font-size: 0.72rem; opacity: 0.85;">Tư vấn sức khỏe trực tuyến 24/7</span>
            </div>
        </div>
        <button id="ai-chat-close" style="background:none;border:none;color:#fff;font-size:1.5rem; opacity: 0.8; line-height: 1;">&times;</button>
    </div>
    <!-- Glass Body -->
    <div id="ai-chat-body" class="ai-chat-glass-body p-3 d-flex flex-column flex-grow-1" style="overflow: hidden; position: relative;">
         <!-- Message Box -->
         <div id="ai-chat-messages" class="flex-grow-1 overflow-auto mb-2 ai-chat-messages-container pe-1 d-flex flex-column gap-3">
             @if (messages.Count == 0)
             {
                 <div class="text-center text-muted my-auto py-4 px-3" id="ai-chat-welcome">
                     <img src="/images/default/ai-bot-doctor.png" alt="AI Bot Doctor" class="mb-3" style="width:85px;height:85px;object-fit:contain;" />
                     <h6 class="fw-bold text-dark mb-2">Xin chào bạn!</h6>
                     <p class="small mb-4 text-secondary" style="line-height: 1.45; font-size: 0.82rem;">Tôi là Trợ lý Dược sĩ AI. Tôi có thể tư vấn sức khỏe, triệu chứng bệnh lý và tìm kiếm các loại thuốc/vitamin phù hợp cho bạn.</p>
                     
                     <!-- Quick Actions -->
                     <div class="d-flex flex-column gap-2" id="ai-quick-container">
                         <div class="text-secondary small fw-bold mb-1" style="font-size:0.7rem; letter-spacing: 0.5px; text-transform: uppercase;">Gợi ý câu hỏi nhanh:</div>
                         <div class="d-flex flex-wrap gap-2 justify-content-center">
                             <div class="ai-suggest-pill" onclick="sendQuickQuestion('💊 Tư vấn Vitamin & Sức đề kháng')">💊 Đề kháng & Vitamin</div>
                             <div class="ai-suggest-pill" onclick="sendQuickQuestion('👶 Thực phẩm bổ sung cho bé tốt nhất')">👶 Tăng trưởng cho bé</div>
                             <div class="ai-suggest-pill" onclick="sendQuickQuestion('🔬 Thuốc bổ gan giải độc hiệu quả')">🔬 Bổ gan giải độc</div>
                             <div class="ai-suggest-pill" onclick="sendQuickQuestion('🤰 Dinh dưỡng bầu và sau sinh')">🤰 Dinh dưỡng mẹ bầu</div>
                         </div>
                     </div>
                 </div>
             }
             else
             {
                 <div class="text-center text-muted mt-2 mb-3" id="ai-chat-welcome">
                     <small class="bg-light px-3 py-1 rounded-pill border" style="font-size: 0.72rem;">Cuộc trò chuyện trước đó</small>
                 </div>
             }
         </div>
         
         <!-- Input Form -->
         <form id="ai-chat-form" class="d-flex gap-2 pt-2 border-top bg-white-50" style="background: rgba(255,255,255,0.45); margin: 0 -1rem -1rem -1rem; padding: 0.75rem 1rem;">
             <input type="text" id="ai-chat-input" class="form-control rounded-pill border-gray-300 shadow-sm" placeholder="Nhập câu hỏi sức khỏe..." autocomplete="off" style="font-size: 0.88rem;" />
             <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow" style="width:38px;height:38px; background: linear-gradient(135deg, #7c3aed, #4f46e5); border: none;"><i class="fa-solid fa-paper-plane text-white" style="font-size: 0.85rem;"></i></button>
         </form>
    </div>
</div>

<style>
    /* Premium AI Chat styles */
    .ai-chat-glass-popup {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        transition: all 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
        transform: translateY(30px) scale(0.95);
        opacity: 0;
        pointer-events: none;
    }
    .ai-chat-glass-popup.active {
        transform: translateY(0) scale(1);
        opacity: 1;
        pointer-events: auto;
    }
    .ai-chat-glass-header {
        background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 14px 18px;
    }
    .ai-chat-glass-body {
        height: 480px;
        background: rgba(248, 250, 252, 0.65);
    }
    .ai-chat-messages-container {
        scrollbar-width: thin;
        scrollbar-color: rgba(124, 58, 237, 0.3) transparent;
        overflow-x: hidden !important;
    }
    .ai-chat-messages-container::-webkit-scrollbar {
        width: 6px;
    }
    .ai-chat-messages-container::-webkit-scrollbar-thumb {
        background: rgba(124, 58, 237, 0.3);
        border-radius: 10px;
    }
    
    /* FAB pulse */
    .ai-fab-container {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .ai-fab-container:hover {
        transform: scale(1.05) translateY(-5px);
    }
    .ai-fab-pulse {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: rgba(124, 58, 237, 0.15);
        animation: ai-pulse 2.2s infinite;
        z-index: -1;
    }
    @@keyframes ai-pulse {
        0% { transform: scale(0.95); opacity: 1; }
        70% { transform: scale(1.3); opacity: 0; }
        100% { transform: scale(0.95); opacity: 0; }
    }
    
    /* Question pills */
    .ai-suggest-pill {
        background: #fff;
        border: 1px solid rgba(124, 58, 237, 0.2);
        color: #4f46e5;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }
    .ai-suggest-pill:hover {
        background: #f5f3ff;
        border-color: #7c3aed;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(124, 58, 237, 0.15);
    }

    /* Typing Dots */
    .typing-dot {
        width: 6px;
        height: 6px;
        background-color: #6b7280;
        border-radius: 50%;
        animation: typing-bounce 1.4s infinite ease-in-out both;
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes typing-bounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1.0); }
    }
    
    /* Shimmer Skeleton */
    .ai-shimmer {
        background: #f6f7f8;
        background-image: linear-gradient(to right, #f6f7f8 0%, #edeef1 20%, #f6f7f8 40%, #f6f7f8 100%);
        background-repeat: no-repeat;
        background-size: 800px 104px;
        animation: shimmer-animate 1.2s infinite linear;
    }
    @@keyframes shimmer-animate {
        0% { background-position: -468px 0; }
        100% { background-position: 468px 0; }
    }
    
    /* Overrides to prevent layout breakage and horizontal scroll from pre-line */
    .ai-product-card {
        white-space: normal !important;
        text-align: left !important;
        display: block !important;
        width: 100% !important;
        max-width: 250px !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
    }
    .ai-product-card .card-body {
        padding: 8px !important;
    }
    .ai-product-card img {
        width: 44px !important;
        height: 44px !important;
        object-fit: cover !important;
    }
    .ai-product-card .fw-semibold {
        font-size: 0.75rem !important;
        line-height: 1.25 !important;
        color: #1f2937 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        display: block !important;
    }
    .ai-product-card .text-muted {
        font-size: 0.65rem !important;
        margin-bottom: 2px !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        display: block !important;
    }
    .ai-product-card .btn-primary {
        font-size: 0.62rem !important;
        padding: 3px 8px !important;
        line-height: 1.2 !important;
    }
</style>

<script>
    let aiChatHistory = @Html.Raw(chatHistory ?? "[]");
    
    document.addEventListener('DOMContentLoaded', function () {
        const popup = document.getElementById('ai-chat-popup');
        const fab = document.getElementById('ai-chat-fab');
        const openBtn = document.getElementById('open-ai-chat');
        const closeBtn = document.getElementById('ai-chat-close');
        
        if (openBtn) {
            openBtn.onclick = function () {
                popup.classList.add('active');
                fab.style.opacity = '0';
                fab.style.pointerEvents = 'none';
                
                // Focus input on open
                setTimeout(() => {
                    const input = document.getElementById('ai-chat-input');
                    if (input) input.focus();
                }, 200);
            };
        }
        
        if (closeBtn) {
            closeBtn.onclick = function () {
                popup.classList.remove('active');
                fab.style.opacity = '1';
                fab.style.pointerEvents = 'auto';
            };
        }
        
        // Load existing session history
        if (aiChatHistory && Array.isArray(aiChatHistory) && aiChatHistory.length > 0) {
            const messagesContainer = document.getElementById('ai-chat-messages');
            if (messagesContainer) {
                // Clear welcome text if there are messages
                const welcomeDiv = document.getElementById('ai-chat-welcome');
                if (welcomeDiv) {
                    welcomeDiv.remove();
                }
            }
            
            aiChatHistory.forEach((msg) => {
                if (msg && (msg.content || msg.Content)) {
                    const messageContent = msg.content || msg.Content;
                    const messageType = msg.type || msg.Type;
                    const messageIsHtml = msg.isHtml || msg.IsHtml || false;
                    addAiMessage(messageType, messageContent, messageIsHtml);
                }
            });
        }
        
        // Form submit Handler
        const chatForm = document.getElementById('ai-chat-form');
        if (chatForm) {
            chatForm.onsubmit = function (e) {
                e.preventDefault();
                const input = document.getElementById('ai-chat-input');
                const msg = input.value.trim();
                if (!msg) return;
                
                addAiMessage('user', msg);
                saveToSession('user', msg);
                input.value = '';
                
                // Show typing indicator
                showTypingIndicator();
                
                // Call API
                callAiBot(msg);
            };
        }
        
        // Send Quick template pills
        window.sendQuickQuestion = function(text) {
            const input = document.getElementById('ai-chat-input');
            if (input) {
                input.value = text;
                const chatForm = document.getElementById('ai-chat-form');
                if (chatForm) {
                    // Trigger standard submit
                    chatForm.dispatchEvent(new Event('submit'));
                }
            }
        }
        
        function callAiBot(question) {
            fetch('/api/aibot/ask', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ question: question, history: aiChatHistory })
            })
            .then(response => response.json())
            .then(data => {
                // Hide typing indicator
                hideTypingIndicator();
                
                if (data.answer) {
                    addAiMessage('bot', data.answer);
                    saveToSession('bot', data.answer);
                } else {
                    const errorMsg = 'Xin lỗi bạn, tôi gặp khó khăn khi xử lý câu hỏi này. Bạn vui lòng thử lại nhé.';
                    addAiMessage('bot', errorMsg);
                    saveToSession('bot', errorMsg);
                }
            })
            .catch(error => {
                console.error('Error calling AI bot:', error);
                hideTypingIndicator();
                const errorMsg = 'Kết nối mạng bị gián đoạn. Xin lỗi bạn vì sự bất tiện này!';
                addAiMessage('bot', errorMsg);
                saveToSession('bot', errorMsg);
            });
        }
        
        function showTypingIndicator() {
            const container = document.getElementById('ai-chat-messages');
            if (!container) return;

            hideTypingIndicator();

            const indicatorDiv = document.createElement('div');
            indicatorDiv.id = 'ai-typing-indicator';
            indicatorDiv.className = 'd-flex mb-3 justify-content-start align-items-center gap-2';
            
            const botIcon = document.createElement('img');
            botIcon.src = '/images/default/ai-bot-doctor.png';
            botIcon.style.width = '26px';
            botIcon.style.height = '26px';
            botIcon.style.objectFit = 'contain';
            botIcon.style.background = 'rgba(124, 58, 237, 0.1)';
            botIcon.style.borderRadius = '50%';
            botIcon.style.padding = '2px';
            
            const bubble = document.createElement('div');
            bubble.className = 'px-3 py-2.5 rounded-3 bg-white border shadow-sm d-flex align-items-center gap-1.5';
            bubble.style.borderRadius = '16px 16px 16px 2px';
            bubble.innerHTML = `
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            `;
            
            indicatorDiv.appendChild(botIcon);
            indicatorDiv.appendChild(bubble);
            container.appendChild(indicatorDiv);
            container.scrollTop = 99999;
        }

        function hideTypingIndicator() {
            const indicator = document.getElementById('ai-typing-indicator');
            if (indicator) {
                indicator.remove();
            }
        }
        
        function addAiMessage(type, msg, isHtml) {
            console.log('addAiMessage called with:', type, msg, isHtml);
            if (!msg) return;
            
            // Remove welcome text if any
            const welcomeDiv = document.getElementById('ai-chat-welcome');
            if (welcomeDiv && type === 'user') {
                welcomeDiv.remove();
            }
            
            const msgDiv = document.createElement('div');
            msgDiv.className = 'd-flex mb-3 ' + (type === 'user' ? 'justify-content-end' : 'justify-content-start align-items-start gap-2');
            
            if (type === 'bot') {
                const botIcon = document.createElement('img');
                botIcon.src = '/images/default/ai-bot-doctor.png';
                botIcon.style.width = '26px';
                botIcon.style.height = '26px';
                botIcon.style.objectFit = 'contain';
                botIcon.style.background = 'rgba(124, 58, 237, 0.1)';
                botIcon.style.borderRadius = '50%';
                botIcon.style.padding = '2px';
                msgDiv.appendChild(botIcon);
            }
            
            const bubble = document.createElement('div');
            bubble.className = 'px-3 py-2.5 rounded-3 shadow-sm ' + (type === 'user' ? 'bg-primary text-white' : 'bg-white text-dark border');
            bubble.style.maxWidth = '82%';
            bubble.style.wordBreak = 'break-word';
            bubble.style.whiteSpace = 'pre-line';
            bubble.style.lineHeight = '1.5';
            bubble.style.fontSize = '0.85rem';
            bubble.style.borderRadius = type === 'user' ? '16px 16px 2px 16px' : '16px 16px 16px 2px';
            
            if (isHtml) {
                bubble.innerHTML = msg;
            } else {
                let htmlContent = '';
                let lastIndex = 0;
                
                const productRegex = /\{PRODUCT:(\d+)\}/g;
                let matches = [];
                let match;
                
                while ((match = productRegex.exec(msg)) !== null) {
                    matches.push({
                        id: match[1],
                        index: match.index,
                        length: match[0].length
                    });
                }
                
                for (let m of matches) {
                    let textSegment = msg.substring(lastIndex, m.index);
                    htmlContent += formatMarkdown(textSegment);
                    
                    // Shimmer skeleton layout
                    htmlContent += `<div class="ai-product-card-placeholder my-3" data-product-id="${m.id}"><div class="ai-shimmer rounded p-2.5 d-flex align-items-center gap-2.5" style="height: 70px; border: 1px solid rgba(0,0,0,0.06);"><div class="rounded bg-secondary-subtle" style="width:45px;height:45px; opacity:0.6;"></div><div class="flex-grow-1"><div class="bg-secondary-subtle rounded mb-2" style="height:10px;width:70%; opacity:0.6;"></div><div class="bg-secondary-subtle rounded" style="height:8px;width:40%; opacity:0.6;"></div></div></div></div>`;
                    lastIndex = m.index + m.length;
                }
                
                htmlContent += formatMarkdown(msg.substring(lastIndex));
                bubble.innerHTML = htmlContent;
                
                // Fetch dynamic product cards
                const placeholders = bubble.querySelectorAll('.ai-product-card-placeholder');
                placeholders.forEach(placeholder => {
                    const productId = placeholder.getAttribute('data-product-id');
                    loadAiProductCard(placeholder, productId);
                });
            }
            
            msgDiv.appendChild(bubble);
            const messagesContainer = document.getElementById('ai-chat-messages');
            if (messagesContainer) {
                messagesContainer.appendChild(msgDiv);
                messagesContainer.scrollTop = 99999;
            }
        }
        
        function formatMarkdown(text) {
            if (!text) return '';
            let formatted = text;
            formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong class="fw-bold" style="color:#5b21b6;">$1</strong>');
            formatted = formatted.replace(/^- (.*?)$/gm, '• $1');
            return formatted;
        }
        
        function loadAiProductCard(placeholder, productId) {
            fetch(`/api/aibot/product/${productId}`)
                .then(response => response.json())
                .then(product => {
                    let priceHtml = '';
                    let badgeHtml = '';
                    
                    if (product.isDiscountActive && product.discountPrice) {
                        const originalPriceStr = product.price.toLocaleString('vi-VN') + 'đ';
                        const discountPriceStr = product.discountPrice.toLocaleString('vi-VN') + 'đ';
                        const discountPercent = product.discountPercent || Math.round((1 - product.discountPrice / product.price) * 100);
                        
                        badgeHtml = `<span class="badge bg-danger rounded-pill position-absolute" style="top: -6px; left: -6px; font-size: 0.65rem; padding: 3px 6px; box-shadow: 0 2px 5px rgba(220,53,69,0.3); z-index: 5;"><i class="fa fa-bolt"></i> -${discountPercent}%</span>`;
                        
                        priceHtml = `
                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                <span class="text-danger fw-bold" style="font-size:0.82rem;">${discountPriceStr}</span>
                                <span class="text-muted text-decoration-line-through" style="font-size:0.72rem;">${originalPriceStr}</span>
                            </div>
                        `;
                    } else {
                        const priceStr = product.price.toLocaleString('vi-VN') + 'đ';
                        priceHtml = `
                            <span class="text-primary fw-bold" style="font-size:0.82rem;">${priceStr}</span>
                        `;
                    }

                    const cardHtml = `
                        <div class="ai-product-card card border shadow-sm my-2.5 position-relative overflow-visible" style="border-radius: 16px; background: rgba(255,255,255,0.95); border: 1px solid rgba(0,0,0,0.06) !important;">
                            ${badgeHtml}
                            <div class="card-body p-2.5">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="flex-shrink-0" style="width: 48px; height: 48px;">
                                        <a href="${product.url}" target="_blank">
                                            <img src="${product.image}" alt="${product.name}" class="rounded-3" style="width:100%;height:100%;object-fit:cover; border: 1px solid rgba(0,0,0,0.05);">
                                        </a>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <a href="${product.url}" target="_blank" class="text-decoration-none text-dark">
                                            <div class="fw-semibold mb-0.5 text-truncate" style="font-size:0.78rem;line-height:1.2; color:#1f2937;" title="${product.name}">${product.name}</div>
                                            <div class="text-muted text-truncate" style="font-size:0.65rem; margin-bottom: 2px;">${product.brand || 'Thương hiệu'}</div>
                                        </a>
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-1">
                                            ${priceHtml}
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fw-bold d-flex align-items-center gap-1 transition-all" onclick="addAiProductToCart(${product.id}, this)" style="background: linear-gradient(135deg, #7c3aed, #4f46e5); border: none; font-size: 0.65rem; box-shadow: 0 4px 8px rgba(124, 58, 237, 0.12);"><i class="fas fa-cart-plus"></i> Mua ngay</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    placeholder.outerHTML = cardHtml;
                })
                .catch(error => {
                    console.error('Error loading product:', error);
                    placeholder.outerHTML = '<div class="text-muted small border rounded p-2 text-center bg-light" style="font-size:0.72rem;"><i class="fas fa-info-circle me-1"></i>Sản phẩm không có sẵn</div>';
                });
        }
        
        window.addAiProductToCart = function (productId, btn) {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('quantity', 1);

            fetch('/Cart/AddToCart', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                if (data.success) {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Đã thêm vào giỏ hàng!', 'success');
                    } else {
                        alert(data.message || 'Đã thêm vào giỏ hàng!');
                    }
                } else if (data.requireLogin) {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Vui lòng đăng nhập để mua hàng.', 'error');
                    } else {
                        alert(data.message || 'Vui lòng đăng nhập!');
                    }
                } else {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Không thể thêm sản phẩm.', 'error');
                    } else {
                        alert(data.message || 'Không thể thêm sản phẩm.');
                    }
                }
            })
            .catch(error => {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                console.error('Error adding to cart:', error);
                if (typeof showToast === 'function') {
                    showToast('Lỗi kết nối giỏ hàng!', 'error');
                } else {
                    alert('Lỗi kết nối giỏ hàng!');
                }
            });
        };
        
        function saveToSession(type, content) {
            aiChatHistory.push({
                type: type,
                content: content,
                timestamp: new Date().toISOString(),
                isHtml: false
            });
            
            if (aiChatHistory.length > 50) {
                aiChatHistory = aiChatHistory.slice(-50);
            }
            
            fetch('/api/aibot/save-chat-history', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(aiChatHistory)
            })
            .then(response => response.json())
            .catch(error => console.error('Error saving chat to session:', error));
        }
    });
</script>

@functions {
    public class ChatMessage
    {
        public string Type { get; set; }
        public string Content { get; set; }
        public string Timestamp { get; set; }
        public bool IsHtml { get; set; }
    }
} 